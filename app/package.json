{
  "name": "store-intelligence-api",
  "version": "1.0.0",
  "description": "Apex Retail Store Intelligence API — real-time CCTV analytics backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage --forceExit",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^8.3.4",
    "dotenv": "^16.4.5",
    "uuid": "^9.0.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.2.0",
    "morgan": "^1.10.0",
    "ws": "^8.17.0",
    "date-fns": "^3.6.0",
    "joi": "^17.12.2",
    "winston": "^3.13.0",
    "express-async-errors": "^3.1.1",
    "compression": "^1.7.4"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "nodemon": "^3.1.0",
    "@types/jest": "^29.5.12"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.js",
      "!node_modules/**",
      "!coverage/**",
      "!server.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 70
      }
    }
  }
}
