# Copy to .env and fill in values

# MongoDB — for local Docker (auto-configured by docker-compose)
MONGO_USER=admin
MONGO_PASSWORD=changeme
# URL-encoded variant of MONGO_PASSWORD, used inside MongoDB connection URIs.
MONGO_PASSWORD_URI=changeme

# MongoDB Atlas URI — override for cloud deployment
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/store_intelligence?retryWrites=true&w=majority

# API
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Optional API key to protect ingest endpoint
API_KEY=

# Store hours for Brigade Road Bangalore
STORE_OPEN_HOUR=11
STORE_CLOSE_HOUR=22

# Anomaly sensitivity
FOOTFALL_SPIKE_MULTIPLIER=2

# Pipeline → API
API_BASE_URL=http://localhost:4000
VISION_API_KEY=

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Dashboard
VITE_API_URL=http://localhost:4000/api
VITE_WS_URL=ws://localhost:4000/ws
